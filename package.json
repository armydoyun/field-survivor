{
  "name": "field-survivor",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "description": "FIELD SURVIVOR — 빌드·테스트 도구 정의(게임 자체는 런타임 의존성 없음)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:release": "node --test tests/release.test.js",
    "test:build": "node tools/build-check.mjs",
    "test:ci": "npm test && npm run test:build",
    "bench:route": "node tools/route-benchmark.mjs",
    "bench:skills": "node tools/skill-benchmark.mjs",
    "bench:autoplay": "node tools/autoplay.mjs 42,7,13 preserve,consume",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write tools",
    "format:check": "prettier --check tools"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "esbuild": "0.24.2",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "playwright": "1.48.2",
    "prettier": "3.3.3"
  }
}
